{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/venv/bin/python \"$CLAUDE_PROJECT_DIR\"/.claude/skills/author-game-lean/scripts/hook.py session-start"
          }
        ]
      }
