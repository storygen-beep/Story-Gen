+# ── Priya at the copy room ───────────────────────────────────────────────────
+[[canvases]]
+id   = "hub_priya_copyroom"
+name = "Priya at the copy room"
+description = "Priya, the senior paralegal, after meet_priya. She hands out the interns' work and hears the floor's talk first."
+
+[canvases.trigger]
+location      = "firm"
+npc           = "npc_priya"
+requires_npc  = "npc_priya"
+is_repeatable = true
+priority      = 6
+is_active     = true
+
+[canvases.trigger.conditions]
+version = "1.0"
+logic   = "AND"
+items = [ { type = "flag", subject = "player", flag_key = "met_priya", operator = "is_true" } ]
+
+[[canvases.nodes]]
+id   = "copy_room"
+name = "The copy room"
+blocks = [
+  { type = "group", props = { conditions = { version = "1.0", logic = "AND", items = [ { type = "trait", subject = "player", trait_key = "office_talk", operator = "gte", value = 3 } ] }, blocks = [
+    { type = "dialog", props = { speaker = "npc", npcId = "npc_priya" }, content = "They're saying your name at the coffee machine. I'm not asking. I'm telling you I heard." },
+  ] } },
+  { type = "group", props = { blocks = [
+    { type = "paragraph", content = "Priya, the senior paralegal, is sorting the interns' work into piles on the copier lid. She looks up when you come in." },
+  ] } },
+  { type = "block_pool", blocks = [
+    { type = "dialog", props = { speaker = "npc", npcId = "npc_priya" }, content = "Contracts want this by four. Don't let anyone on litigation talk you into theirs first." },
+    { type = "dialog", props = { speaker = "npc", npcId = "npc_priya" }, content = "The interns who last are the ones who come to me before they run out of work. Remember that." },
+    { type = "dialog", props = { speaker = "npc", npcId = "npc_priya" }, content = "Loose Tie asked me your name this morning. I told him to ask you himself. He won't." },
+  ] },
+]
+
+[canvases.nodes.exit_block]
+type = "choices"
+
+[[canvases.nodes.exit_block.choices]]
+text       = "Take the pile and get back to work."
+targetType = "location"
+locationId = "firm"
+time_progression_minutes = 5
+
