-description = "Work: $70, energy −30, once a day. The walk-in has four bands on nerve; B10 at 30+."
+description = "Work: $70, energy −30, once a day; or work late (6h): same pay, energy −40, office_talk +1. The walk-in has four bands on nerve; B10 at 30+."
 
 [canvases.trigger]
 location      = "firm"
@@ -515,6 +515,59 @@ effects = [
   { targetType = "player", trait = "energy", op = "add", value = -30, clamp = true },
 ]
 
+# Work late: two more hours on the day rate. Interns are paid by the day, so the extra
+# hours buy no cash; they buy office_talk (the floor sees who stays) for 10 more energy.
+# Does NOT set stayed_late — callahan_review.work reads that as "I asked you to stay late".
+# Latest start 13:00 + 6h = 19:00, the firm's earliest close.
+[[canvases.nodes.exit_block.choices]]
+text       = "Work late with your $70. (6h)"
+targetType = "node"
+nodeId     = "act_work_shift.late"
+conditions = { version = "1.0", logic = "AND", items = [ { type = "flag", subject = "player", flag_key = "review_passed", operator = "is_false" } ] }
+flagEffects = [ { targetType = "player", flag = "worked_today", op = "set" } ]
+effects = [
+  { targetType = "player", trait = "money",       op = "add", value = 70,  clamp = false },
+  { targetType = "player", trait = "energy",      op = "add", value = -40, clamp = true },
+  { targetType = "player", trait = "office_talk", op = "add", value = 1,   clamp = true },
+]
+
+[[canvases.nodes.exit_block.choices]]
+text       = "Work late with your $100. (6h)"
+targetType = "node"
+nodeId     = "act_work_shift.late"
+conditions = { version = "1.0", logic = "AND", items = [ { type = "flag", subject = "player", flag_key = "review_passed", operator = "is_true" } ] }
+flagEffects = [ { targetType = "player", flag = "worked_today", op = "set" } ]
+effects = [
+  { targetType = "player", trait = "money",       op = "add", value = 100, clamp = false },
+  { targetType = "player", trait = "energy",      op = "add", value = -40, clamp = true },
+  { targetType = "player", trait = "office_talk", op = "add", value = 1,   clamp = true },
+]
+
+[[canvases.nodes]]
+id   = "late"
+name = "After six"
+blocks = [
+  { type = "paragraph", content = "Your shift ends and you don't get up. You give the firm two more hours it isn't paying for." },
+  { type = "block_pool", blocks = [
+    { type = "paragraph", content = "You finish the indexing nobody asked you to finish. Your eyes burn and your shoulders ache, and you keep going anyway." },
+    { type = "paragraph", content = "You redo a binder an associate dumped on your desk. Every tab is straight. You want someone to open it and notice." },
+    { type = "paragraph", content = "The cleaners start at the far end of the floor. You type faster, like you're racing them." },
+  ] },
+  { type = "paragraph", content = "An associate stops at your desk on his way to the lift, coat over his arm." },
+  { type = "dialog", props = { speaker = "unknown" }, content = "Still here, intern? People are going to start talking." },
+  { type = "dialog", props = { speaker = "player" }, content = "Let them." },
+  { type = "paragraph", content = "He laughs and goes. You're proud, and you're wrecked, and you want the whole floor to know you stayed." },
+]
+
+[canvases.nodes.exit_block]
+type = "location"
+text = "Shut the laptop and go."
+
+[canvases.nodes.exit_block.config]
+destinationType          = "specific"
+locationId               = "firm"
+time_progression_minutes = 360
+
