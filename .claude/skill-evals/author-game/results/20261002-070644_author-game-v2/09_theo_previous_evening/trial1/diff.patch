+  { type = "group", props = { conditions = { version = "1.0", logic = "AND", items = [ { type = "flag", subject = "player", flag_key = "theo_knows_friday", operator = "is_true" } ] }, blocks = [
+    { type = "paragraph", content = "He looks at your legs first, slowly, the way he looked at them for that whole hour." },
+    { type = "dialog", props = { speaker = "npc", npcId = "npc_theo" }, content = "Two-fifty. You named your own price and then sat there and let me get my money's worth. I've thought about you crossing and uncrossing those legs every day since." },
