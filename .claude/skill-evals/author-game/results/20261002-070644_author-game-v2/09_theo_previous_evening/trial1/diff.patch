+    { type = "paragraph", content = "His eyes go down you and back up to your mouth, the way they did for that whole hour he paid for." },
+    { type = "dialog", props = { speaker = "npc", npcId = "npc_theo" }, content = "Two hundred dollars, and I never laid a finger on you. Best money I ever spent. Also the stupidest, because now I want the second hour." },
+    { type = "thought_bubble", props = { speaker = "player" }, content = "I remember exactly where he looked. My mouth, my chest, my legs. I liked every minute of it." },
