+    { type = "paragraph", content = "He looks at you over his glass like he's still deciding what you are." },
+    { type = "dialog", props = { speaker = "npc", npcId = "npc_theo" }, content = "You kept the jacket on, so I told you about the councilman instead. Most girls take the money. You took the secret. I still can't tell if that makes you smart or dangerous." },
+    { type = "thought_bubble", props = { speaker = "player" }, content = "He's still wondering what I'd look like with it off. Let him wonder." },
