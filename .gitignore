# ============================================================
# Claude Code skills — never ignore anything inside a skill
# (skills bundle their own node_modules, lib/, etc. — partial
# tracking breaks them at runtime)
# ============================================================
!.claude/skills/
!.claude/skills/**

# ============================================================
# twine-game-explorer: browser profiles, saves, screenshots
# (binary/transient runtime output — not source)
# ============================================================
game_explorations/*/manual/profile/
game_explorations/*/profile/
game_explorations/*/screenshots/live/
game_explorations/*/archive/
game_explorations/*/.live/

# ============================================================
# Playable output media is TRACKED for LIVE-on-the-portal games (the
# portal needs it). Overrides the blanket videos/ + media-extension
# ignores above. Re-include the dir first, then its contents — git
# cannot re-include a file whose parent directory is still excluded.
# Add a game's output/videos here when it goes live on the portal.
# ============================================================
!games/vesper/output/videos/
!games/vesper/output/videos/**
!games/the_inheritance/output/videos/
!games/the_inheritance/output/videos/**

# ============================================================
# find-media working evidence (harvest dumps, montages, candidate
# jsonl, raw transcripts) — large + transient, never source.
# ============================================================
**/.find-media/

# ============================================================
# Heavy experiments / scratch — local only, not part of the engine.
# ============================================================
test_blender/
avatar_prototype/
games/media_testbed/
# The WHOLE research corpus is local-only now (2026-07-09). It was 806 MB of the ~1.0 GB tracked tree,
# which pushed the published GitHub Pages site over its 1 GB hard limit -> every build after b067942
# failed with "Page build failed". Untracked with `git rm -r --cached` (files kept on disk, and the
# history still has them), so the portal publishes ~263 MB and builds again. Supersedes the two
# sub-dir entries below.
game_explorations/
game_explorations/vesper_coverplay/
game_explorations/vesper_wardrobe/

# playwright-skill temp execution files (transient)
**/.temp-execution-*.js
