king:</em> She brought me the leash and asked me to put it on her. I'll teach her to want, all right. Just not for him.</div></div></span><br><br><br><br><br><br><br><br><br><br><a data-passage=\"Location_Audrey's_Room\" class=\"link-internal\" tabindex=\"0\">Tell her you'll teach her.</a>","modal_text":null,"variables_snapshot":{"last_game_passage":"Canvas_aud_teachme_Node_1","player":{"name":"Catherine","portrait":"catherine.jpg","current_location":"a2e68cd4-af85-4dab-bc5e-2f355017faac","core_traits":{"corruption":0,"arousal":0,"energy":100,"hygiene":100,"money":50,"exhibitionism":0,"audrey_stage":0,"grayson_stage":0,"richard_stage":0,"margaret_stage":0},"wardrobe":{"in_bra":{"id":"in_bra","name":"Plain Bra","slot":"bra","image":"./videos/clothing/in_bra.jpg"},"in_briefs":{"id":"in_briefs","name":"Plain Briefs","slot":"underwear","image":"./videos/clothing/in_briefs.jpg"},"in_blouse":{"id":"in_blouse","name":"Linen Blouse","slot":"top","image":"./videos/clothing/in_blouse.jpg"},"in_slacks":{"id":"in_slacks","name":"Tailored Slacks","slot":"bottom","image":"./videos/clothing/in_slacks.jpg"},"in_flats":{"id":"in_flats","name":"Flats","slot":"shoes","image":"./videos/clothing/in_flats.jpg"},"in_day_dress":{"id":"in_day_dress","name":"Day Dress","slot":"dress","image":"./videos/clothing/in_day_dress.jpg"}},"equipped":{"bra":"in_bra","underwear":"in_briefs","top":"in_blouse","bottom":"in_slacks","dress":"in_day_dress","legwear":null,"shoes":"in_flats"},"body_type":"average","look":"composed"},"npcs":{"f8b6da59-9955-4300-b46e-662426238c45":{"name":"Audrey","portrait":"audrey.jpg","core_traits":{"arousal":1,"corruption":11,"relation":25},"flags":{},"schedule":[],"relationship":""},"1569a9d0-eef1-47a0-86c0-d7c49889a136":{"name":"Grayson","portrait":"grayson.jpg","core_traits":{"arousal":0,"corruption":0,"relation":0},"flags":{},"schedule":[],"relationship":""},"c47e428a-bc10-4277-a995-148efc3bbcdb":{"name":"Richard","portrait":"richard.jpg","core_traits":{"arousal":0,"cor