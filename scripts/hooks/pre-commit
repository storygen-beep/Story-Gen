#!/bin/sh
# Three checks before a commit, each run only when its files are staged.
#
# 0. THE ENGINE CITE FIX (added 2026-11-03). Runs first, and never refuses a commit. A commit
#    that stages an engine file the skill cites (v2.py, template_import.py, stories/models.py,
#    game_service.py — the TARGETS in cite_check.py) can move the lines the skill's
#    file:line citations point at. When cite_check.py finds wrong cites in SKILL.md +
#    references/, this runs cite_check.py --fix and stages the moved line numbers in the
#    same commit. A doc file that already had other unstaged edits is fixed on disk but not
#    staged, so those edits never slip into an engine commit. Cites --fix cannot move
#    (ranges, ambiguous anchors) are listed for a later hand fix.
#    Why: the main session's engine commits drifted 62 cites on 2026-11-02 and 17 more on
#    11-03. The skill check (1) only runs when skill files are staged, so nothing caught them.
#    LO: a bad cite never fails a build (cite_check.py docstring), and development is not
#    blocked. Limit: cites are checked against the engine file on disk, not the staged copy.
#
# 1. THE SKILL CHECK (added 2026-11-02). A commit that stages anything in the author-game-v2
#    skill (.claude/skills/author-game-v2/) or its agents (.claude/agents/v2-*.md) is refused
#    when the skill's own checkers are red:
#      · gates.py --selfcheck — SKILL.md indexes exactly what gates.py emits
#      · cite_check.py --strict — no file:line citation in SKILL.md + references/ points at
#        the wrong line (LO's baseline is 0, 2026-09-28)
#      · the exam's grader tests (.claude/skill-evals/author-game/tests) — no Claude sessions
#      · the skill's script tests, only when scripts/ is staged
#    It also says how old the last exam run is. That line only warns: the exam costs about an
#    hour of plan quota, so it is never run from here.
#    Why: the 2026-11-02 audit found these checkers existed and nobody ran them. Citations had
#    drifted to 71 wrong under a baseline of 0, and the exam had not run since 2026-10-04.
#    The checkers read the files on disk, not the staged copies.
#
# 2. THE SHIP CHECK (added 2026-09-26, PRD WS6, ~/Documents/Process_Review_20260925/
#    PRD_SKILL_CHANGES.md). Refuse a commit that would publish a v2 game build that fails the
#    ship check. Committing games/<slug>/output/index.html or games-data.js IS publishing:
#    the portal is served straight from the committed tree. So this is the one place a build
#    can be held. It checks a slug only when all of these hold (the parsing lives in gates.py
#    --ship-targets, so the portal is read one way, and the STAGED portal is the one read):
#      · its build, or games-data.js, is staged
#      · it is a v2 game (games/<slug>/v2_state.json exists) — v1 games such as vesper are
#        never caught
#      · its portal entry is NOT `dev: true` — a test build passes straight through
#    It also refuses while any built piece has no play note from LO (pieces.py release-check).
#
# Install:  ln -s ../../scripts/hooks/pre-commit .git/hooks/pre-commit
# Bypass, for an emergency only:  git commit --no-verify

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0

py="$root/venv/bin/python"
[ -x "$py" ] || py=python3
skill=".claude/skills/author-game-v2"
gates="$root/$skill/scripts/gates.py"

# What LO staged in the skill, read before the engine cite fix can stage anything: the fix's
# own line-number moves must not start the minute-long skill check.
skill_staged=$(git diff --cached --name-only --diff-filter=ACMRD \
                 -- "$skill/" '.claude/agents/v2-*.md')

# ── 0. the engine cite fix (never refuses) ──────────────────────────────────
engine_staged=$(git diff --cached --name-only --diff-filter=ACMR -- \
                  apps/game_generation/twee_comprehensive/generators/v2.py \
                  apps/projects/services/template_import.py \
                  apps/stories/models.py \
                  apps/game_generation/services/game_service.py)
cite="$root/$skill/scripts/cite_check.py"
if [ -n "$engine_staged" ] && [ -f "$cite" ]; then
  # The number of wrong cites in SKILL.md + references/, from cite_check's summary line.
  wrong_cites() {
    PYTHONDONTWRITEBYTECODE=1 "$py" "$cite" 2>/dev/null \
      | sed -n 's/.*SKILL\.md + references\/: \([0-9][0-9]*\) citation.*/\1/p' | tail -1
  }
  doc_sums() {
    find "$skill/SKILL.md" "$skill/references" -name '*.md' -type f -exec cksum {} + 2>/dev/null
  }
  before=$(wrong_cites)
  if [ -n "$before" ] && [ "$before" -gt 0 ]; then
    dirty=$(git diff --name-only -- "$skill/SKILL.md" "$skill/references")
    sums_before=$(doc_sums)
    PYTHONDONTWRITEBYTECODE=1 "$py" "$cite" --fix > /dev/null 2>&1
    sums_after=$(doc_sums)
    after=$(wrong_cites)
    [ -n "$after" ] || after=$before
    fixed_files=$(printf '%s\n' "$sums_after" | grep -vxF "$sums_before" | awk '{print $3}')
    held=""
    for f in $fixed_files; do
      if printf '%s\n' "$dirty" | grep -qxF "$f"; then
        held="$held $f"
      else
        git add -- "$f"
      fi
    done
    echo "pre-commit: the engine moved $before skill cite(s): $((before - after)) fixed, $after left"
    for f in $held; do
      echo "  fixed on disk, not staged: $f has other edits — commit it with them"
    done
    if [ "$after" -gt 0 ]; then
      PYTHONDONTWRITEBYTECODE=1 "$py" "$cite" --verbose 2>/dev/null \
        | grep -E '^ +(SKILL\.md|references/)[^ ]*:[0-9]+ '
      echo "  fix these by hand when convenient; this commit goes ahead"
    fi
  fi
fi

# ── 1. the skill check ──────────────────────────────────────────────────────
if [ -n "$skill_staged" ]; then
  echo "pre-commit: author-game-v2 is staged — running the skill's own checks"

  refuse() {
    echo ""
    echo "pre-commit: REFUSED — $1"
    echo "Fix it and commit again. Emergency only: git commit --no-verify"
    exit 1
  }

  PYTHONDONTWRITEBYTECODE=1 "$py" "$gates" --selfcheck \
    || refuse "gates.py --selfcheck is red: SKILL.md and gates.py disagree (rows above)."

  PYTHONDONTWRITEBYTECODE=1 "$py" "$root/$skill/scripts/cite_check.py" --strict > /dev/null
  if [ $? -ne 0 ]; then
    PYTHONDONTWRITEBYTECODE=1 "$py" "$root/$skill/scripts/cite_check.py" --verbose \
      | grep -E '^ +(SKILL\.md|references/)[^ ]*:[0-9]+ '
    refuse "citations in SKILL.md + references/ point at the wrong line (listed above). \
Run cite_check.py --fix, then fix the rest by hand."
  fi

  PYTHONDONTWRITEBYTECODE=1 "$py" -m pytest .claude/skill-evals/author-game/tests \
    -q -p no:cacheprovider \
    || refuse "the exam's grader tests are red (.claude/skill-evals/author-game/tests)."

  if echo "$skill_staged" | grep -q "^$skill/scripts/"; then
    PYTHONDONTWRITEBYTECODE=1 "$py" -m pytest "$skill/scripts/tests" -q -p no:cacheprovider \
      || refuse "the skill's script tests are red ($skill/scripts/tests)."
  fi

  # How old is the last exam run? Result folders are named YYYYmmdd-HHMMSS_<skill>_<set>.
  last_exam=$(ls -1 .claude/skill-evals/author-game/results 2>/dev/null \
                | grep -E '^[0-9]{8}-[0-9]{6}_' | sort | tail -1)
  last_skill_commit=$(git log -1 --date=format:%Y%m%d-%H%M%S --format=%cd -- "$skill/")
  if [ -z "$last_exam" ]; then
    echo "pre-commit: warning — the exam has never been run on this checkout."
  elif [ -n "$last_skill_commit" ] && [ "${last_exam%%_*}" \< "$last_skill_commit" ]; then
    echo "pre-commit: warning — the last exam run ($last_exam) is older than the last skill"
    echo "  commit ($last_skill_commit). Run it by hand when the skill has moved:"
    echo "  venv/bin/python .claude/skill-evals/author-game/run.py"
  else
    echo "pre-commit: last exam run $last_exam"
  fi
  echo "pre-commit: skill checks green"
fi

# ── 2. the ship check ───────────────────────────────────────────────────────
staged=$(git diff --cached --name-only --diff-filter=ACMR \
           -- 'games/*/output/index.html' 'games-data.js')
[ -z "$staged" ] && exit 0

tmp=$(mktemp) || exit 1
trap 'rm -f "$tmp"' EXIT
if git cat-file -e :games-data.js 2>/dev/null; then
  git show :games-data.js > "$tmp"
  targets=$("$py" "$gates" --ship-targets --portal "$tmp" $staged)
else
  targets=$("$py" "$gates" --ship-targets $staged)
fi
[ -z "$targets" ] && exit 0

failed=0
for slug in $targets; do
  "$py" "$gates" --ship "$slug" || failed=1
  # A public build waits for LO's own play of every built piece (pieces.py, 2026-11-02).
  "$py" "$root/$skill/scripts/pieces.py" release-check "$slug" || failed=1
done

if [ "$failed" -ne 0 ]; then
  echo "pre-commit: the ship check failed — this commit would publish a build that is"
  echo "broken, unfinishable, untrue or not yet played by LO. Fix the rows above, or keep"
  echo "the portal entry at dev: true until it passes."
  exit 1
fi
exit 0
