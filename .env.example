# Django Configuration
SECRET_KEY=django-insecure-development-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_NAME=story_gen_django_dev
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Supabase Connection Examples (uncomment and fill to use) ---
#
# PGSSLMODE is required for Supabase connections; libpq/psycopg reads it.
# For stricter verification, consider PGSSLMODE=verify-full with PGSSLROOTCERT.

# Supabase (Direct)
# DB_HOST=db.<project-ref>.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=<your-db-password>
# PGSSLMODE=require

# Supabase (Pooler)
# DB_HOST=<region>.pooler.supabase.net
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=<your-db-user>
# DB_PASSWORD=<your-db-password>
# PGSSLMODE=require

# Redis Configuration (for production)
REDIS_URL=redis://127.0.0.1:6379/1

# Email Configuration (for production)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Monitoring (for production)
SENTRY_DSN=

# SSL Settings (for production)
SECURE_SSL_REDIRECT=True

# --- Cloudflare R2 (S3-compatible) media storage ---
# Enable R2-backed media storage via django-storages
R2_ENABLED=False
# Either set ACCOUNT_ID to compose the endpoint, or provide full endpoint URL
R2_ACCOUNT_ID=
# R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional custom/public domain for reads (e.g., media.example.com)
R2_PUBLIC_DOMAIN=
# If true, generate signed URLs (keep buckets private). If false and bucket is public,
# URLs will be unsigned. Prefer True for private user content.
R2_SIGNED_URLS=True

# --- AI Clip Description Generation Configuration ---

# VLLM Frame Captioning Configuration (JoyCaption)
# Generates detailed captions for individual video frames
VLLM_CAPTIONING_ENABLED=false
VLLM_BASE_URL=http://joycaption:8000/v1
VLLM_MAX_TOKENS=150
# Max tokens per frame caption (range: 1-512, default: 150)
# Controls detail level of individual frame captions:
#   64 tokens  = ~50 words  (brief, basic description)
#   150 tokens = ~115 words (detailed, recommended)
#   512 tokens = ~384 words (maximum, very detailed)

# Grok AI Clip Description Configuration
# Synthesizes frame captions into coherent clip descriptions
GROK_CLIP_DESCRIPTIONS_ENABLED=true
GROK_MODEL=grok-4-fast
GROK_TEMPERATURE=0.7
GROK_MAX_TOKENS=800
# Max tokens per clip description (default: 800, optimized for 500-word script-style)
# The prompt instructs Grok to generate exactly 500 words; this limit provides
# a safety buffer to prevent mid-sentence truncation if the LLM slightly overruns.
# Controls length of synthesized clip description:
#   300 tokens  = ~225 words  (brief, will truncate)
#   700 tokens  = ~525 words  (too tight, may truncate)
#   800 tokens  = ~600 words  (recommended: handles 500-word target with 20% buffer)
#   1000 tokens = ~750 words  (safe, more expensive)
#   2000 tokens = ~1500 words (maximum, very expensive)
GROK_MIN_FRAMES=3
GROK_TIMEOUT_SEC=30

# Token Limit Guidelines:
# - Actual token count varies by content
# - Rule of thumb: tokens ≈ words × 1.33
# - Higher limits provide more detail but increase API costs and processing time
# - VLLM increase: ~2.3x processing time (64→150 tokens)
# - Grok increase: ~3.3x processing time (300→1000 tokens)